{
  "name": "study-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord AI Challenge Management & Auto-Grading System",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/core.test.ts src/config.test.ts src/services/health.service.test.ts src/utils/retry.test.ts",
    "test:integration": "node --import tsx --test src/integration/repository.integration.test.ts src/integration/challenge-registration.integration.test.ts src/integration/challenge-approval.integration.test.ts src/integration/challenge-publication.integration.test.ts src/integration/submission-reservation.integration.test.ts src/integration/submission-completion.integration.test.ts src/integration/submission-grading-queue.integration.test.ts src/integration/submission-grading-worker.integration.test.ts src/integration/submission-grading-failure.integration.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx src/scripts/check-database.ts",
    "config:check": "tsx src/scripts/check-config.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:bootstrap": "npm run db:up && npm run db:check && npm run db:migrate:deploy",
    "db:migrate": "prisma migrate dev --name init",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^1.20.0",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.2",
    "pino": "^10.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
